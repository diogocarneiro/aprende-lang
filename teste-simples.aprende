// Teste simples da Linguagem Aprende - Automático
mostra "🧪 TESTE AUTOMÁTICO DA LINGUAGEM APRENDE"
mostra "========================================="

// Teste de variáveis
mostra "📝 Testando variáveis..."
definir nome "Aprende"
definir versao 1.1
mostra "Linguagem: " nome " v" versao
mostra "✅ Variáveis funcionando!"

// Teste de operadores em português
mostra ""
mostra "🔢 Testando operadores em português..."
definir a 10
definir b 5
definir soma calcular a mais b
definir subtracao calcular a menos b
mostra a " mais " b " = " soma
mostra a " menos " b " = " subtracao
mostra "✅ Operadores em português funcionando!"

// Teste de operadores simbólicos
mostra ""
mostra "➕ Testando operadores simbólicos..."
definir mult calcular a * b
definir div calcular a / b
mostra a " * " b " = " mult
mostra a " / " b " = " div
mostra "✅ Operadores simbólicos funcionando!"

// Teste de condicionais
mostra ""
mostra "🔀 Testando condicionais..."
se a maior b entao
    mostra a " é maior que " b " ✅"
senao
    mostra a " não é maior que " b " ❌"

// Teste de loop
mostra ""
mostra "🔄 Testando loop..."
para i de 1 ate 3
    mostra "Iteração " i

mostra ""
mostra "🎉 TODOS OS TESTES PASSARAM COM SUCESSO!"
mostra "A Linguagem Aprende está funcionando perfeitamente!"

mostra "Fim do teste."