// Teste simples de condicionais
mostra "=== TESTE DE CONDICIONAIS ==="

definir opcao ler "Digite 1 ou 2: "

se opcao igual "1" entao
    mostra "Você escolheu opção 1!"
    mostra "Fazendo soma..."
    definir a 10
    definir b 5
    definir resultado calcular a + b
    mostra "Resultado: " a " + " b " = " resultado

se opcao igual "2" entao
    mostra "Você escolheu opção 2!"
    mostra "Fazendo subtração..."
    definir a 10
    definir b 3
    definir resultado calcular a - b
    mostra "Resultado: " a " - " b " = " resultado

mostra "Fim do teste."